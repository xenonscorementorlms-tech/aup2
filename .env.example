# Copy this file to .env and fill in the values for the engine you're
# pointing at. This project never talks to OpenAI directly - it only
# calls the private autoproduct-engine API.

# The engine's base URL - a local dev server while testing, the deployed
# Lightsail URL when demoing to a client.
API_BASE_URL=http://localhost:3000

# Shared secret, must match the engine's API_KEY.
API_KEY=your-shared-secret-here
